{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cloudFunctions": {
    "nodejs": {
      "includeFiles": [],
      "maxDuration": 120,
      "externalNodeModules": ["discord.js"]
    }
  },
  "schedules": [
    {
      "name": "discord-gateway",
      "cron": "*/10 * * * *",
      "timezone": "Asia/Shanghai",
      "method": "POST",
      "path": "/gateway-tick"
    }
  ],
  "agents": {
    "timeout": 600,
    "framework": "openai-agents-sdk",
    "sandbox": {
      "timeout": 600
    }
  }
}
