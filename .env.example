# LLM Gateway Configuration
# Required: OpenAI-compatible LLM API credentials
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional: model name (defaults to @makers/deepseek-v4-flash)
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# Slack Events API
# Request URL: https://<domain>/slack-webhook  (Edge Function — HMAC verify + 200)
# Worker: POST /slack-process (Cloud Function + Chat SDK; do not point Slack here)
# Signing Secret: Slack app → Basic Information → App Credentials
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Bot User OAuth Token (xoxb-): Slack app → OAuth & Permissions
# After changing Bot Token Scopes, click Reinstall to Workspace or the token keeps the old scopes.
# Required Bot Token Scopes:
#   users:read          Chat SDK users.info (display name); missing this logs missing_scope
#   app_mentions:read   @mentions
#   chat:write          replies
#   channels:history, groups:history, im:history, mpim:history
#   channels:read, groups:read, im:read, mpim:read
SLACK_BOT_TOKEN=xoxb-your-bot-token
