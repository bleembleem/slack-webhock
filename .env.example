# LLM Gateway Configuration
# Required: OpenAI-compatible LLM API credentials
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional: model name (defaults to @makers/deepseek-v4-flash)
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# Async agent callback
# A Cloud Function is killed at 120s, so an IM webhook posts a "Thinking…"
# placeholder, hands the run to /chat without waiting, and the agent POSTs the
# answer to https://<domain>/chat-callback, which edits the placeholder.
# That route can make the bot speak in any channel it can reach, so it is the
# bearer token for it. Required — replies fail without it.
AGENT_CALLBACK_SECRET=your-random-callback-secret

# Slack Events API
# Request URL: https://<domain>/slack  (Edge Function — classify + forward)
# Worker: POST /chat-process (Cloud Function + Chat SDK; do not point Slack here)
# Signing Secret: Slack app → Basic Information → App Credentials
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Bot User OAuth Token (xoxb-): Slack app → OAuth & Permissions
# After changing Bot Token Scopes, click Reinstall to Workspace or the token keeps the old scopes.
# Required Bot Token Scopes:
#   users:read          Chat SDK users.info (display name); missing this logs missing_scope
#   app_mentions:read   @mentions
#   chat:write          replies
#   channels:history, groups:history, im:history, mpim:history
#   channels:read, groups:read, im:read, mpim:read
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Discord Interactions + Gateway
# Interactions Endpoint URL: https://<domain>/discord
# Enable Message Content Intent. Regular @mentions arrive only over the Gateway.
#
# Gateway: POST https://<domain>/discord-gateway (Agents runtime, 9 min/window)
#   Authorization: Bearer <DISCORD_GATEWAY_SECRET or CRON_SECRET>
#   makers-conversation-id: <any 6-36 chars of [0-9a-zA-Z-_.]>
#   `?chain=1` re-arms the next window, `?ms=` shortens the run for testing,
#   `?probe=1` times how long the runtime allows without touching Discord.
# It lives in agents/ because cloudFunctions.maxDuration caps at 120s while this
# runtime allows 600s (measured; agents.timeout cannot raise it). Discord resets
# a bot token that connects more than ~1000 times a day; 120s windows need ~800
# reconnects a day, 9-minute windows need ~160. Rotate DISCORD_GATEWAY_SECRET to
# stop a chain. Never run two listeners on one token.
# `npm run gateway` runs the same listener locally as a fallback.
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_PUBLIC_KEY=your-64-char-hex-public-key
DISCORD_APPLICATION_ID=your-application-id
# Optional: comma-separated role IDs that should trigger onNewMention
# DISCORD_MENTION_ROLE_IDS=1234567890,0987654321
# Optional: parent channel IDs whose messages trigger the bot without an @mention
# DISCORD_RESPOND_TO_CHANNEL_IDS=1234567890
# Required to start POST /discord-gateway (falls back to CRON_SECRET)
DISCORD_GATEWAY_SECRET=your-random-gateway-secret
# Where `npm run gateway` forwards events; defaults to the production /discord
# DISCORD_WEBHOOK_URL=https://<domain>/discord
