# LLM Gateway Configuration
# Required: OpenAI-compatible LLM API credentials
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional: model name (defaults to @makers/deepseek-v4-flash)
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# Slack Events API
# Request URL: https://<domain>/slack  (Edge Function — classify + forward)
# Worker: POST /chat-process (Cloud Function + Chat SDK; do not point Slack here)
# Signing Secret: Slack app → Basic Information → App Credentials
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Bot User OAuth Token (xoxb-): Slack app → OAuth & Permissions
# After changing Bot Token Scopes, click Reinstall to Workspace or the token keeps the old scopes.
# Required Bot Token Scopes:
#   users:read          Chat SDK users.info (display name); missing this logs missing_scope
#   app_mentions:read   @mentions
#   chat:write          replies
#   channels:history, groups:history, im:history, mpim:history
#   channels:read, groups:read, im:read, mpim:read
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Discord Interactions + Gateway
# Interactions Endpoint URL: https://<domain>/discord
# Gateway keep-alive: GET https://<domain>/discord/gateway
#   Authorization: Bearer <DISCORD_GATEWAY_SECRET or CRON_SECRET>
# Enable Message Content Intent. Regular @mentions need the Gateway listener.
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_PUBLIC_KEY=your-64-char-hex-public-key
DISCORD_APPLICATION_ID=your-application-id
# Optional: comma-separated role IDs that should trigger onNewMention
# DISCORD_MENTION_ROLE_IDS=1234567890,0987654321
# Optional: parent channel IDs whose messages trigger the bot without an @mention
# DISCORD_RESPOND_TO_CHANNEL_IDS=1234567890
# Required to start GET /discord/gateway (falls back to CRON_SECRET)
DISCORD_GATEWAY_SECRET=your-random-gateway-secret
